[flake8]
# flake8 cannot read pyproject.toml, so its settings live here.
# E302: Expected 2 blank lines
# E501: Line too long
# E704: Multiple statements on one line (def)
# F403: 'from module import *' used; unable to detect undefined names
# F405: Name may be undefined, or defined from star imports
# W503: Line break occurred before a binary operator
ignore = E302, E501, E704, F403, F405, W503
# tests/app is a fixture Shiny app for the deploy-app workflow, not this repo's code.
exclude = docs, .venv, _dev, tests/app
