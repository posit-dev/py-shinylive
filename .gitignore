instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

typings/
.DS_Store

# Agent tools. Only the shared skills folder is tracked.
/.claude/*
!/.claude/skills

# Contributor skills. Tools like `npx skills` or `uvx library-skills` install
# dependency skills into .agents/skills/ (and through the .claude/skills
# symlink), so only the skills listed here are tracked. Update this list when
# adding or removing a skill.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/memory-bank/

# uv
uv.lock
